// TIU Telegram Bot — ma'lumotlar bazasi sxemasi
// PostgreSQL (Neon — Vercel Marketplace orqali ulanadi)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migratsiyalar uchun pool'siz ulanish (Neon beradi).
  // Belgilanmagan bo'lsa Prisma DATABASE_URL dan foydalanadi.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────
// Talabalar
// ─────────────────────────────────────────────────────────────
model Student {
  id             String  @id @default(cuid())
  passportSeries String  @unique // AA1234567 (normalize: UPPER, bo'shliqsiz)
  pinfl          String? @unique // JSHSHIR (14 raqam) — ixtiyoriy
  fullName       String
  phone          String?
  birthDate      String?

  facultyId String?
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  facultyName String? // Fakultet DB'da bo'lmasa — matn sifatida
  program     String // Ta'lim yo'nalishi
  course      Int     @default(1)
  groupName   String
  eduForm     String  @default("KUNDUZGI") // KUNDUZGI | SIRTQI | KECHKI | MASOFAVIY
  eduType     String  @default("KONTRAKT") // KONTRAKT | GRANT

  // STUDYING | DEBT_SUBJECTS | THREE_DEBTS | REPEAT_YEAR | EXPELLED | ACADEMIC_LEAVE | GRADUATED
  status     String  @default("STUDYING")
  statusNote String?

  // JSON array: [{"name":"Matematika","credit":5,"semester":3}]
  debtSubjects String @default("[]")

  contractTotal Float   @default(0)
  contractPaid  Float   @default(0)
  contractYear  String?

  isActive  Boolean        @default(true)
  botUsers  BotUser[]
  messages  StaffMessage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([groupName])
  @@index([facultyId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Fakultet va mas'ul xodimlar
// ─────────────────────────────────────────────────────────────
model Faculty {
  id     String @id @default(cuid())
  nameUz String
  nameRu String
  nameEn String
  code   String @unique
  sort   Int    @default(0)

  isActive Boolean        @default(true)
  staff    FacultyStaff[]
  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FacultyStaff {
  id        String  @id @default(cuid())
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  role     String // CURATOR | VICE_DEAN | DEPARTMENT | DEAN
  fullName String

  // Topikli guruhdagi mavzu (forum topic) identifikatori
  topicId Int?

  positionUz String @default("")
  positionRu String @default("")
  positionEn String @default("")

  phone     String?
  email     String?
  telegram  String? // @username
  room      String? // Xona / bino
  workHours String?

  groupNames String? // Kurator uchun: "IF-101, IF-102"
  course     Int? // Kurs dekan o'rinbosari uchun

  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages StaffMessage[]

  @@index([facultyId, role])
}

// ─────────────────────────────────────────────────────────────
// Talaba ↔ mas'ul xodim yozishmalari (topikli guruh orqali)
// ─────────────────────────────────────────────────────────────
model StaffMessage {
  id String @id @default(cuid())

  staffId String?
  staff   FacultyStaff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  botUserId String?
  botUser   BotUser? @relation(fields: [botUserId], references: [id], onDelete: SetNull)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  direction String // IN (talabadan) | OUT (xodimdan)
  text      String

  // Guruhda yuborilgan xabar id'si — javobni ushbu xabarga reply qilib bog'lanadi
  groupMessageId Int?
  groupThreadId  Int?

  // Xodim javobini kim yozgani (Telegram)
  replierName     String?
  replierUsername String?

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([staffId])
  @@index([botUserId])
  @@index([groupMessageId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Savol-javoblar (FAQ)
// ─────────────────────────────────────────────────────────────
model FaqCategory {
  id       String  @id @default(cuid())
  titleUz  String
  titleRu  String
  titleEn  String
  emoji    String  @default("📌")
  sort     Int     @default(0)
  isActive Boolean @default(true)

  items     Faq[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Faq {
  id         String       @id @default(cuid())
  categoryId String?
  category   FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  questionUz String
  questionRu String
  questionEn String
  answerUz   String
  answerRu   String
  answerEn   String

  sort      Int      @default(0)
  views     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────
// Chet mamlakatlarda o'qish
// ─────────────────────────────────────────────────────────────
model StudyAbroadProgram {
  id      String @id @default(cuid())
  country String
  flag    String @default("🌍")

  titleUz String
  titleRu String
  titleEn String

  descriptionUz String
  descriptionRu String
  descriptionEn String

  universityName String?
  durationUz     String?
  durationRu     String?
  durationEn     String?
  requirementsUz String?
  requirementsRu String?
  requirementsEn String?

  deadline    String?
  contactInfo String?
  link        String?

  sort      Int      @default(0)
  views     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Bot foydalanuvchilari
// ─────────────────────────────────────────────────────────────
model BotUser {
  id         String  @id @default(cuid())
  telegramId String  @unique
  username   String?
  firstName  String?
  lastName   String?
  phone      String?

  lang String @default("uz") // uz | ru | en
  step String @default("START") // START | LANG | PASSPORT | MENU | SUPPORT | STAFF_MSG

  // «Xabar yozish» bosilganda — qaysi xodimga yozayotgani
  pendingStaffId String?

  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  isVerified Boolean  @default(false)

  failedAttempts Int      @default(0)
  isBlocked      Boolean  @default(false)
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  logs     ActivityLog[]
  tickets  SupportTicket[]
  messages StaffMessage[]

  @@index([studentId])
  @@index([isVerified])
}

model ActivityLog {
  id        String   @id @default(cuid())
  botUserId String?
  botUser   BotUser? @relation(fields: [botUserId], references: [id], onDelete: Cascade)

  action    String // start | lang_select | passport_ok | passport_fail | menu:status ...
  payload   String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

// Pasport topilmaganda — mas'ul xodimga so'rov
model SupportTicket {
  id        String   @id @default(cuid())
  botUserId String?
  botUser   BotUser? @relation(fields: [botUserId], references: [id], onDelete: SetNull)

  telegramId String
  username   String?
  fullName   String?
  passport   String?
  message    String  @default("")
  status     String  @default("NEW") // NEW | IN_PROGRESS | RESOLVED
  adminNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Admin panel
// ─────────────────────────────────────────────────────────────
model AdminUser {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  fullName     String
  role         String  @default("ADMIN") // SUPERADMIN | ADMIN | MODERATOR
  isActive     Boolean @default(true)

  // Telegram Mini App orqali kirish uchun
  telegramId   String?   @unique
  linkCode     String?   @unique
  linkCodeExp  DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────
// Botning pastki (reply) klaviatura tugmalari
// ─────────────────────────────────────────────────────────────
model MenuButton {
  id String @id @default(cuid())

  labelUz String
  labelRu String
  labelEn String

  // BUILTIN — tizim bo'limi | TEXT — matn chiqaradi | LINK — matn + havola | WEBAPP — mini ilova
  type String @default("BUILTIN")

  // BUILTIN uchun: status | faq | abroad | contacts | lang | help
  action String?

  contentUz String?
  contentRu String?
  contentEn String?
  url       String?

  row      Int     @default(0) // qaysi qatorda
  sort     Int     @default(0) // qator ichidagi tartib
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([row, sort])
}

// Bot matnlari — admin paneldan tahrirlanadi
model BotText {
  id   String  @id @default(cuid())
  key  String  @unique
  uz   String
  ru   String
  en   String
  note String?

  updatedAt DateTime @updatedAt
}

model Broadcast {
  id     String @id @default(cuid())
  textUz String
  textRu String
  textEn String

  target      String  @default("ALL") // ALL | VERIFIED | UNVERIFIED | FACULTY | COURSE | GROUP | STATUS
  targetValue String?

  status     String @default("DRAFT") // DRAFT | SENDING | DONE | FAILED
  sentCount  Int    @default(0)
  failCount  Int    @default(0)
  totalCount Int    @default(0)

  createdBy  String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
